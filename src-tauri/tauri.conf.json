{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Bytesize",
  "version": "0.1.0",
  "identifier": "app.bytesize.disk-analyzer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Bytesize",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "decorations": true,
        "focus": true,
        "acceptFirstMouse": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 28
        },
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "category": "Utility",
    "shortDescription": "Bytesize — Disk Space Analyzer",
    "longDescription": "See what is taking up space on your Mac with a fast, interactive radial disk map.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
